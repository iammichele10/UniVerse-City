rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(
          /databases/$(database)/documents/admins/$(request.auth.token.email)
        );
    }

    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /posts/{postId} {
      // Public users can read published posts only.
      allow read: if resource.data.status == 'published';

      // Only admins can create, edit, or delete posts.
      allow create, update, delete: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dailyViews/{viewId} {
      // Needed for Trending Now and the admin Analytics page.
      allow read: if true;

      // Allow the website to create or update daily view totals.
      allow create, update: if
        request.resource.data.postId is string
        && request.resource.data.date is string
        && request.resource.data.views is number
        && request.resource.data.views >= 0;

      // Only admins can delete daily view records.
      allow delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;

      allow delete: if request.auth != null
        && (
          resource.data.authorUid == request.auth.uid
          || isAdmin()
        );

      allow update: if false;
    }
  }
}